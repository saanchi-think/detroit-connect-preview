NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:5200
# Keep this server-only. Required by email delivery and automatic search indexing.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only notification email delivery. Schedule
# GET /api/notifications/digest with Authorization: Bearer <NOTIFICATION_CRON_SECRET>.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="Detroit Connect <notifications@example.com>"
NOTIFICATION_CRON_SECRET=

# Server-only AI search configuration.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Protects the automatic search-index worker endpoint.
SEARCH_INDEX_CRON_SECRET=
